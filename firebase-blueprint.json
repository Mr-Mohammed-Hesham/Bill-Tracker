{
  "entities": {
    "IncomeEntry": {
      "title": "IncomeEntry",
      "description": "A household monthly income source record.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Income title or label"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Income source category"
        },
        "amount": {
          "type": "number",
          "description": "Positive income amount"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date YYYY-MM-DD"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "Month key YYYY-MM"
        },
        "notes": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional notes"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Creator Firebase Auth UID"
        },
        "createdByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Creator email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "source",
        "amount",
        "date",
        "month",
        "notes",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExpenseEntry": {
      "title": "ExpenseEntry",
      "description": "A daily household expense or monthly bill record.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "food",
            "utilities",
            "housing",
            "transport",
            "health",
            "shopping",
            "family",
            "entertainment",
            "other"
          ]
        },
        "entryType": {
          "type": "string",
          "enum": ["daily", "bill"]
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending"]
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "category",
        "entryType",
        "status",
        "amount",
        "date",
        "month",
        "notes",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavingEntry": {
      "title": "SavingEntry",
      "description": "A household savings deposit or withdrawal record.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "goalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": ["deposit", "withdraw"]
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "goalName",
        "kind",
        "amount",
        "date",
        "month",
        "notes",
        "createdByUid",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "HouseholdSettings": {
      "title": "HouseholdSettings",
      "description": "Shared household budget and currency preferences.",
      "type": "object",
      "properties": {
        "householdName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "monthlyBudgetLimit": {
          "type": "number"
        },
        "monthlySavingsTarget": {
          "type": "number"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "householdName",
        "currency",
        "monthlyBudgetLimit",
        "monthlySavingsTarget",
        "updatedByUid",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/IncomeEntry" },
      "description": "Monthly income records for the household"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseEntry" },
      "description": "Daily expenses and household bills"
    },
    "/savings/{savingId}": {
      "schema": { "$ref": "#/entities/SavingEntry" },
      "description": "Household savings deposits and withdrawals"
    },
    "/householdSettings/{settingId}": {
      "schema": { "$ref": "#/entities/HouseholdSettings" },
      "description": "Shared household configuration"
    }
  }
}
